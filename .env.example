# Base URL for the Approved Platform (AP) Flow Service
PA_BASE_URL_FLOW=https://api.flow.votre-pa.fr/flow-service

# Base URL of the PPF Annuaire (directory) service. Optional — defaults to the
# production URL from the bundled swagger's `servers` block. Override for
# sandbox testing.
# PPF_ANNUAIRE_BASE_URL=https://aife.economie.gouv.fr/ppf/annuaire-public/v1

# PA_BASE_URL_DIRECTORY is deprecated and no longer read (see PPF_ANNUAIRE_BASE_URL above).

# OAuth2 client_credentials credentials (provided by the AP)
PA_CLIENT_ID=xxx
PA_CLIENT_SECRET=xxx

# OAuth2 token URL of the AP
PA_TOKEN_URL=https://auth.votre-pa.fr/oauth/token

# OAuth2 scope shared by both services (used if per-service scopes below are not set)
PA_OAUTH_SCOPE=

# Per-service OAuth2 scopes (optional; override PA_OAUTH_SCOPE for each service independently)
# Set these when your AP issues different scopes for the Flow and Directory services.
PA_OAUTH_SCOPE_FLOW=
PA_OAUTH_SCOPE_DIRECTORY=

# PPF party GlobalID for the CDAR second RecipientTradeParty (optional; unset
# by default — no bundled worked-example value is a stable production
# identifier). See FR-CDAR-PPF-RECIPIENT-2026-07.
PPF_GLOBAL_ID=
PPF_SCHEME_ID=0238
PPF_NAME=PPF
PPF_ROLE_CODE=DFH

# HTTP timeout in seconds (default: 30)
HTTP_TIMEOUT=30

# Enable debug logging (true/false)
DEBUG=false
